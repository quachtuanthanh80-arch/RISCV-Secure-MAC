keywords:
  - "RISC-V"
  - "Fault-Tolerant Computing"
  - "Deep Neural Networks"
  - "Multiply-Accumulator (MAC)"
  - "Concurrent Error Detection (CED)"
  - "Residue Number System"
  - "Single-Event Upset (SEU)"
